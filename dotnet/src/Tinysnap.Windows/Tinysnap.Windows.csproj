<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Tinysnap.ico</ApplicationIcon>
    <!-- Tinysnap.exe, carrying the Mac app's version: every release ships both at once. -->
    <AssemblyName>Tinysnap</AssemblyName>
    <Product>Tinysnap</Product>
    <Version>1.1.0</Version>
    <!-- The shipped build leaves out the .NET code it never calls: about 22 MB to download instead
         of 60. CI runs Tinysnap.exe with self-check on that build, as the tests run the full one. -->
    <PublishTrimmed>true</PublishTrimmed>
    <!-- Warnings inside Windows' own API bridge, which the self-check's text reading covers. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tinysnap.App\Tinysnap.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tinysnap.Windows.Tests" />
  </ItemGroup>

  <!-- Debug symbols stay out of what ships: the graphics libraries alone brought 100 MB of them.
       So do the runtime's debugger and crash dump helpers, which only a debugger ever loads. -->
  <Target Name="LeaveOutDebugging" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(Filename)').StartsWith('mscordaccore')) Or '%(Filename)' == 'mscordbi' Or '%(Filename)' == 'createdump' Or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.DiaSymReader'))" />
    </ItemGroup>
  </Target>

</Project>
